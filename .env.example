# 복사해서 .env 로 쓴 뒤 값을 채운다. .env 는 커밋하지 않는다.
# (Spring Boot 는 .env 를 자동으로 읽지 않으므로 export 하거나 실행 환경에 주입한다)

# 공공데이터포털 인증키 (미설정 시 해당 소스는 목 데이터로 동작)
WEATHER_SERVICE_KEY=
FINE_DUST_SERVICE_KEY=
SUBWAY_SERVICE_KEY=

# 키 없이 목 데이터로 응답하는 것을 허용할지 (false 면 키 누락 시 기동 실패)
PUBLIC_DATA_MOCK_WHEN_KEY_MISSING=true

# 업스트림 주소/경로를 바꿔야 할 때 (포털 문서 확인 후 조정)
# WEATHER_BASE_URL=http://apis.data.go.kr
# WEATHER_PATH=/1360000/GetVilageFcst/getVilageFcst
# WEATHER_NX=60
# WEATHER_NY=127
# FINE_DUST_BASE_URL=http://openapi.epa.go.kr
# FINE_DUST_PATH=/main/service/realm/getTrend1DayRealTimeTierSR
# FINE_DUST_REALM_CODE=11
# SUBWAY_BASE_URL=http://smss.seoul.go.kr:9001
# SUBWAY_PATH=/openapi2013/data/getCongestionStationDataInfoService/getCongestionStationDataInfo
# SUBWAY_LINE_ID=02

# 캐시/갱신 주기
# PUBLIC_DATA_CACHE_TTL=60s
# PUBLIC_DATA_REFRESH_INTERVAL=60s
# PUBLIC_DATA_CONNECT_TIMEOUT=3s
# PUBLIC_DATA_READ_TIMEOUT=5s

# 서버 포트
# SERVER_PORT=8080
